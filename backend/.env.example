# Copy this file to .env and fill in real values. .env is gitignored — never commit secrets.

ENVIRONMENT=development

# --- Database ---
# Matches the postgres service in docker-compose.yaml
DATABASE_URL=postgresql+asyncpg://resume_user:resume_password@postgres:5432/resume_builder

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- AI provider ---
OPENAI_API_KEY=sk-...

# --- CORS ---
CORS_ORIGINS=http://localhost:5173
