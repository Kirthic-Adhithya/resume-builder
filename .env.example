# Copy to .env (gitignored). docker-compose reads this automatically for ${VAR}
# substitution below — this is the ONLY .env docker-compose itself consumes.
# backend/.env and frontend/.env.local are separate, for running those services
# outside Docker (e.g. `uvicorn` directly against a docker-composed Postgres).

# --- Postgres ---
POSTGRES_USER=resume_user
POSTGRES_PASSWORD=resume_password
POSTGRES_DB=resume_builder

# --- Backend ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
# Free tier, no credit card required: https://console.groq.com/keys
GROQ_API_KEY=gsk_...
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
